{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/card-quality.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/favorites-waitlist.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/home-banners.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "images": {
    "sizes": [384, 640, 750, 1080],
    "localPatterns": [
      { "pathname": "^/api/product-image$" }
    ],
    "minimumCacheTTL": 2592000,
    "qualities": [82],
    "formats": ["image/webp"]
  },
  "functions": {
    "api/sync-catalog.js": { "maxDuration": 60 },
    "api/migrate-product-images.js": { "maxDuration": 60 },
    "api/order-webhook.js": { "maxDuration": 30 },
    "api/get-data.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/sync-catalog", "schedule": "0 3 * * *" },
    { "path": "/api/migrate-product-images", "schedule": "* * * * *" },
    { "path": "/api/scan-product-image-changes", "schedule": "* * * * *" }
  ]
}
